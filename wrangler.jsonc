{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "outpredict",
  "account_id": "8b1ada8b10e9e8e5664ec10bd9d3c370",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_URL": "https://outpredict.anywager.workers.dev",
    "AI_MODEL": "@cf/openai/gpt-oss-120b"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "outpredict",
      "database_id": "adb959a3-48f1-4d38-b074-f3765918fdbb",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "outpredict-data"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "outpredict-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_URL": "https://outpredict-staging.anywager.workers.dev",
        "AI_MODEL": "@cf/openai/gpt-oss-120b"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "outpredict-staging",
          "database_id": "23df57b3-4ce5-47c0-85a6-e6e016dce87c",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA",
          "bucket_name": "outpredict-staging-data"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "secrets": {
        "required": [
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "BETTER_AUTH_SECRET"
        ]
      }
    },
    "production": {
      "name": "outpredict",
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_URL": "https://outpredict.anywager.workers.dev",
        "AI_MODEL": "@cf/openai/gpt-oss-120b"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "outpredict",
          "database_id": "adb959a3-48f1-4d38-b074-f3765918fdbb",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA",
          "bucket_name": "outpredict-data"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "secrets": {
        "required": [
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "BETTER_AUTH_SECRET"
        ]
      }
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/healthz", "/privacy", "/terms"]
  },
  "build": {
    "command": "npm run build:client",
    "watch_dir": ["frontend", "index.html", "vite.config.ts"]
  },
  "dev": {
    "port": 8787
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "BETTER_AUTH_SECRET"
    ]
  }
}
