{
  "name": "outpredict",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "cf-typegen": "wrangler types",
    "lint": "biome check src package.json biome.json tsconfig.json wrangler.jsonc",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "build": "wrangler deploy --dry-run --env staging --outdir dist/staging && wrangler deploy --dry-run --env production --outdir dist/production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "wrangler": "4.130.0"
  }
}
